# Private working notes — never published
NOTES*.md

# Secrets and local config
.env
.env.*
!.env.example
# The E2E tests' key list (e2e/README.md); the real e2e/.env.e2e holds test passwords and stays out.
!e2e/.env.e2e.example
# Firebase service-account keys (push notifications) are secret; they go to EAS only
# (docs/OPERATIONS.md "Push notifications"). google-services.json is NOT one of these: it is
# committed on purpose (docs/DECISIONS.md #34).
*-firebase-adminsdk-*.json
*service-account*.json
# Signing material and tool credentials, anywhere in the repo (docs/DECISIONS.md #155): the
# Android keystore and EAS's credentials.json (`eas credentials` downloads), private keys and
# certificates, and npm settings that can hold a registry token.
credentials.json
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
.npmrc
# Claude Code's local settings and worktrees in the main folder (app/.claude/settings.json is
# shared on purpose and stays tracked).
/.claude/

# Dependencies and build output
node_modules/
dist/
web-build/
# Playwright's results, report and saved sign-ins (e2e/)
e2e/test-results/
e2e/playwright-report/
e2e/.auth/

# Logs
*.log

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# OS files
.DS_Store
Thumbs.db
# wrangler's local cache (Cloudflare Pages uploads)
.wrangler/
