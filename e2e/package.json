{
  "name": "mridanga-seva-e2e",
  "private": true,
  "description": "End-to-end tests of the web version on the TEST project (e2e/README.md). Kept out of app/package.json so the app's fingerprint never changes.",
  "type": "module",
  "scripts": {
    "e2e": "node scripts/run.mjs",
    "e2e:build": "node scripts/run.mjs --build-only",
    "e2e:env": "node scripts/make-env.mjs",
    "e2e:code": "node scripts/sign-in-code.mjs",
    "e2e:check": "node scripts/check-logins.mjs",
    "e2e:install": "playwright install chromium webkit",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@supabase/supabase-js": "2.118.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.3.0 || >=25.0.0"
  }
}
