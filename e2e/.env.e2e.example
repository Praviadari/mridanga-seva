# Keys of e2e/.env.e2e (gitignored). `npm run e2e:env` writes the real file with new random passwords.
# TEST project only; the addresses must be e2e.<role>@example.com. Values here are placeholders.
E2E_STUDENT_EMAIL=e2e.student@example.com
E2E_STUDENT_PASSWORD=
E2E_COORDINATOR_EMAIL=e2e.coordinator@example.com
E2E_COORDINATOR_PASSWORD=
E2E_GURU_EMAIL=e2e.guru@example.com
E2E_GURU_PASSWORD=
# Set-up key of the coordinator's sign-in code, written by `npm run e2e:code`. Empty = no code step.
E2E_COORDINATOR_TOTP_SECRET=
# Optional: a Guru code (only if the Guru login was given one) and the local port (default 8190).
# E2E_GURU_TOTP_SECRET=
# E2E_PORT=8190
