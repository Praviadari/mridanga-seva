    "green": { "50": "#ECFDF3", "400": "#47CD89", "700": "#067647", "950": "#10291C" },
    "amber": { "50": "#FEF3C7", "200": "#FDE68A", "400": "#FBBF24", "700": "#B54708", "800": "#92400E", "900": "#78350F", "950": "#3A2A0A" },
    "red": { "50": "#FEF3F2", "400": "#F97066", "700": "#B42318", "950": "#3A1A17" },
