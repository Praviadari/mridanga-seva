  "$chips": "Small status labels: [text, background] as semantic names. Amber 'warning' = needs someone to act (#338).",
  "chips": {
    "info": ["info", "infoSurface"], "success": ["success", "successSurface"], "warning": ["warning", "warningSurface"],
    "neutral": ["neutral", "neutralSurface"], "paused": ["paused", "pausedSurface"], "danger": ["danger", "dangerSurface"],
    "level": ["onPrimarySoft", "primarySoft"]
  },

  "$modules": "The home circles' colours (wayfinding, not brand; unchanged from round 4): [background, icon].",
  "modules": {
    "light": {
      "green": ["#DCFCE7", "#15803D"], "blue": ["#DBEAFE", "#1D4ED8"], "purple": ["#EDE9FE", "#6D28D9"], "orange": ["#FFEDD5", "#C2410C"],
