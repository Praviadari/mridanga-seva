    "earth": {
      "50": "#F6EEE4", "150": "#C8BFB6", "200": "#C3B5A6", "300": "#A89A8D", "400": "#8C7B6C", "450": "#8A7B6E",
      "500": "#64544A", "600": "#5B4F46", "800": "#3A2F27", "850": "#2E2620", "900": "#2A211B", "925": "#1F1813",
      "950": "#15100C", "975": "#24170F"
