  "space": { "xxs": 2, "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 32, "xxl": 48 },
  "radii": { "sm": 6, "md": 10, "lg": 16, "xl": 24, "pill": 999 },
  "font": {
    "$comment": "serif = Cormorant Garamond SemiBold (OFL), loaded at run time by expo-font, the English headings; Telugu and Hindi headings use Noto Serif Telugu / Devanagari SemiBold at the sans sizes (app/src/theme/fonts.tsx, DECISIONS #367); names and staff-typed titles stay sans.",
    "serif": "CormorantGaramond-SemiBold",
    "serifFile": "app/assets/fonts/CormorantGaramond-SemiBold.ttf"
  },
  "type": {
    "$comment": "Serif steps are larger than the sans ones they replace: Cormorant's small letters are short.",
    "serifTitle": { "fontSize": 28, "lineHeight": 36 },
    "serifSubtitle": { "fontSize": 22, "lineHeight": 30 }
  },

