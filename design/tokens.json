      "400": "#F2A33A", "450": "#F59E0B", "500": "#D9821F", "600": "#B45309", "700": "#9A4307", "800": "#8A3A0E",
      "850": "#742C0B", "900": "#6E2D0B", "950": "#5C2108", "960": "#5C2B0C", "980": "#3A2817", "990": "#2E1609"
