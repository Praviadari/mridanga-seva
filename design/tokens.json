    "website": [
      ["--ink", "--bg"], ["--ink", "--paper"], ["--muted", "--bg"], ["--muted", "--paper"], ["--link", "--bg"], ["--link", "--paper"],
      ["--link-hover", "--bg"], ["--accent", "--bg"], ["--accent", "--paper"], ["--accent-ink", "--accent"], ["--accent-ink", "--accent-hover"],
