# Copy this file to .env and fill in your own Supabase project's values.
# Copy it to .env.test too, with the TEST project's values: the test web site and test APK are
# built from that file (docs/OPERATIONS.md "Publishing the web version").
# Supabase dashboard -> Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key only. It is safe in the app because row-level security protects the data.
# NEVER put the service_role (secret) key here or anywhere in this repository.
EXPO_PUBLIC_SUPABASE_KEY=your-anon-or-publishable-key
