# Copy this file to .env.development and .env.test with the TEST project's values, and (only on a
# computer that builds the class's site) to .env.live with the LIVE project's values. Keep no
# plain .env: Expo loads it in every mode (app/README.md "Settings files", docs/DECISIONS.md #145).
# Supabase dashboard -> Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key only. It is safe in the app because row-level security protects the data.
# NEVER put the service_role (secret) key here or anywhere in this repository.
EXPO_PUBLIC_SUPABASE_KEY=your-anon-or-publishable-key
