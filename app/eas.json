{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    },
    "facetest": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "facetest"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "facetest"
    }
  }
}
