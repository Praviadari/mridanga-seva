{
  "expo": {
    "name": "Mridanga Seva",
    "slug": "mridanga-seva",
    "owner": "mridanga-seva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mridangaseva",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "org.mridangaseva.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#B45309",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Mridanga Seva",
      "shortName": "Mridanga",
      "themeColor": "#B45309",
      "backgroundColor": "#B45309"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B45309",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Mridanga Seva uses the camera to scan students' QR codes for attendance.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mridanga Seva opens your photos only when you add one to an announcement or an answer.",
          "microphonePermission": "Mridanga Seva uses the microphone only when you record a video answer with the camera."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#B45309",
          "defaultChannel": "announcements"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Mridanga Seva uses the microphone only when you record your practice or an answer.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mridanga Seva checks your location only while the app is open, to confirm you are at the class when you mark attendance.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-sharing",
      "expo-screen-orientation",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "24fef1a4-4c05-46e9-9c32-3975fba80ff0"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/24fef1a4-4c05-46e9-9c32-3975fba80ff0",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
