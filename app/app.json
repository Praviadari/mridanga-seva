{
  "expo": {
    "name": "Mridanga Seva",
    "slug": "mridanga-seva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mridangaseva",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "org.mridangaseva.app",
      "adaptiveIcon": {
        "backgroundColor": "#B45309",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Mridanga Seva",
      "shortName": "Mridanga",
      "themeColor": "#B45309",
      "backgroundColor": "#B45309"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B45309",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Mridanga Seva uses the camera to scan students' QR codes for attendance.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mridanga Seva opens your photos only when you add one to an announcement.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#B45309",
          "defaultChannel": "announcements"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
